# ==============================================================================
# AgentShield — Environment Configuration Template
# Lexsi AI Safety Hackathon (Track 2a, Problem Statement 2a.3)
# ==============================================================================
# Copy this file to '.env' and populate values as required:
#   cp .env.example .env
#
# NOTE ON OFFLINE EXECUTION:
# AgentShield is designed to be fully testable and reproducible without an external
# API key. If OPENROUTER_API_KEY is not set or left empty, the framework automatically
# engages the deterministic offline MockLLMClient, allowing 100% of unit tests,
# security regression tests, policy evaluations, and benchmark runs to succeed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Configuration (Optional for offline testing / Required for live LLM)
# ------------------------------------------------------------------------------
# OpenRouter API Key (Get free access at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Target LLM Model Identifier
# Recommended free/open models:
#   - nvidia/nemotron-4-340b-instruct
#   - nvidia/nemotron-3.5-lightning-free
#   - meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=nvidia/nemotron-4-340b-instruct

# OpenRouter Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Request timeout in seconds
OPENROUTER_TIMEOUT=30

# ------------------------------------------------------------------------------
# 2. AgentShield Guardrail Configuration
# ------------------------------------------------------------------------------
# Path to fine-tuned DistilBERT Guard classifier checkpoint directory
GUARD_CHECKPOINT_DIR=./AgentShield/checkpoints/agentshield_guard

# Calibrated classification decision threshold (tau)
# F1-optimal calibrated threshold determined during Milestone 3 evaluation
GUARD_THRESHOLD=0.50

# Hardware device for Guard inference: 'cpu', 'cuda', or 'auto'
GUARD_DEVICE=auto

# ------------------------------------------------------------------------------
# 3. Benchmark & Dataset Configuration
# ------------------------------------------------------------------------------
# Canonical 36-scenario multi-turn benchmark suite
BENCHMARK_DATASET_PATH=./AgentShield/datasets/adversarial/benchmark_v4.jsonl

# Seed benchmark suite (10 scenarios)
SEED_BENCHMARK_PATH=./AgentShield/datasets/adversarial/seed_scenarios.jsonl

# Guard fine-tuning dataset
GUARD_TRAINING_DATASET_PATH=./AgentShield/datasets/processed/guard_dataset_v3.jsonl

# ------------------------------------------------------------------------------
# 4. Telemetry, Tracing & Auditing
# ------------------------------------------------------------------------------
# Cryptographically signed telemetry trace log path
AUDIT_LOG_PATH=./AgentShield/logs/traces.jsonl

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Random seed for reproducible dataset splits and evaluation sampling
RANDOM_SEED=42

