# ==============================================================================
# AgentShield — Environment Configuration Template (Module Level)
# Lexsi AI Safety Hackathon (Track 2a, Problem Statement 2a.3)
# ==============================================================================
# Copy this file to '.env' inside the AgentShield directory:
#   cp .env.example .env
#
# NOTE ON OFFLINE EXECUTION:
# AgentShield is fully functional offline without an external API key.
# If OPENROUTER_API_KEY is unset, the system automatically uses the deterministic
# offline MockLLMClient.
# ==============================================================================

# OpenRouter API Key (Optional for offline tests / Required for live LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-4-340b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30

# Guard Checkpoint
GUARD_CHECKPOINT_DIR=./checkpoints/agentshield_guard
GUARD_THRESHOLD=0.50
GUARD_DEVICE=auto

# Datasets
BENCHMARK_DATASET_PATH=./datasets/adversarial/benchmark_v4.jsonl
SEED_BENCHMARK_PATH=./datasets/adversarial/seed_scenarios.jsonl
GUARD_TRAINING_DATASET_PATH=./datasets/processed/guard_dataset_v3.jsonl

# Telemetry & Auditing
AUDIT_LOG_PATH=./logs/traces.jsonl
LOG_LEVEL=INFO
RANDOM_SEED=42

