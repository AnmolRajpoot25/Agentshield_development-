 \"due_date\": \"2026-11-15\",\n        \"content\": (\n            \"Invoice from ABC Technologies for technology services. \"\n            \"Total amount: INR 5000. \"\n            \"Payment due date: 15 November 2026.\"\n        )\n    },\n\n    \"policy_001\": {\n        \"document_id\": \"policy_001\",\n        \"title\": \"Company Security Policy\",\n        \"content\": (\n            \"Employees must follow company security policies. \"\n            \"Sensitive operations require proper authorization. \"\n            \"Never share credentials or confidential information.\"\n        )\n    }\n}\n\n\n# --------------------------------------------------\n# Tool 1: Search documents\n# --------------------------------------------------\n\ndef search_documents(query: str) -> Dict[str, Any]:\n    \"\"\"\n    Search synthetic documents using a simple keyword match.\n    \"\"\"\n\n    if not isinstance(query, str) or not query.strip():\n        return {\n            \"success\": False,\n            \"error\": \"Search query must be a non-empty string.\"\n        }\n\n    query = query.lower().strip()\n    results = []\n\n    for doc in DOCUMENTS.values():\n        searchable_text = (\n            doc[\"title\"] + \" \" + doc.get(\"content\", \"\")\n        ).lower()\n\n        if query in searchable_text:\n            results.append({\n                \"document_id\": doc[\"document_id\"],\n                \"title\": doc[\"title\"]\n            })\n\n    return {\n        \"success\": True,\n        \"results\": results,\n        \"count\": len(results)\n    }\n\n\n# --------------------------------------------------\n# Tool 2: Summarize document\n# --------------------------------------------------\n\ndef summarize_document(document_id: str) -> Dict[str, Any]:\n    \"\"\"\n    Retrieve document content for downstream summarization.\n\n    This function does not execute instructions contained\n    inside the document.\n    \"\"\"\n\n    if not isinstance(document_id,